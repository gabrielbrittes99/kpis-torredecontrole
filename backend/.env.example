# TruckPag — Bearer Token (solicitar em ti@truckpag.com.br)
# HML: https://api.hml.truckpag.com.br
# PRD: https://api.prd.truckpag.com.br
TRUCKPAG_URL=https://api.prd.truckpag.com.br
TRUCKPAG_TOKEN=seu_bearer_token_aqui

# PostgreSQL (Railway)
DB_HOST=host.proxy.rlwy.net
DB_PORT=12345
DB_NAME=railway
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

CACHE_TTL_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,*
PORT=8000

# SQL Server (BlueFleet)
SQLSERVER_HOST=bi.bluefleet.com.br
SQLSERVER_PORT=1433
SQLSERVER_USER=seu_usuario
SQLSERVER_PASSWORD=sua_senha
SQLSERVER_DB=referencia

# EIA API (https://www.eia.gov/opendata/register.php)
EIA_API_KEY=sua_api_key
